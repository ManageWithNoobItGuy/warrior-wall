# Copy to .env and fill in. .env is gitignored — never commit the real key.

# Google AI Studio key for the image model. Without it the app still works,
# it just hides the AI avatar section.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # "nano banana" (default)
# AVATAR_LIMIT=3                              # generations per student per session
# AVATAR_CONCURRENCY=3                        # simultaneous calls to the image API
# AVATAR_QUEUE=24                             # students allowed to wait in line
# PORT=4173
